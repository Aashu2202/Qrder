# --------------------------------------------------------------------
# Qrder — environment variables
# Copy to .env and fill in real values. Never commit .env.
# --------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=4000

# Database — Postgres (Neon in prod, Docker locally)
DATABASE_URL=postgres://qrder:qrder@localhost:5432/qrder

# Redis (for Socket.IO adapter + BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace_me_with_a_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=8h
QR_TOKEN_SECRET=replace_me_with_another_long_random_string

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Cloudinary (menu images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend public env (Next.js — must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
