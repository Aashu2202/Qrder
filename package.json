{
  "name": "qrder",
  "private": true,
  "version": "0.1.0",
  "description": "QR-first restaurant & bar management SaaS",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @qrder/db db:generate",
    "db:migrate": "pnpm --filter @qrder/db db:migrate",
    "db:push": "pnpm --filter @qrder/db db:push",
    "db:studio": "pnpm --filter @qrder/db db:studio",
    "db:seed": "pnpm --filter @qrder/db db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1",
    "prettier": "^3.4.2"
  }
}
