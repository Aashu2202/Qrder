{
  "name": "@qrder/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:docs": "tsx scripts/build-testing-pdf.tsx",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "echo \"(no lint configured)\"",
