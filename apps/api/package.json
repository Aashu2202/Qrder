    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@qrder/auth": "workspace:*",
    "@qrder/db": "workspace:*",
    "@qrder/pdf": "workspace:*",
    "@qrder/shared": "workspace:*",
    "@react-pdf/renderer": "^4.1.6",
    "react": "^19.0.0",
    "compression": "^1.7.5",
    "drizzle-orm": "^0.38.3",
    "qrcode": "^1.5.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
